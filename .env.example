# Copia este archivo como .env y pon tu clave aqui.
# Obten una clave en: https://console.cloud.google.com/google/maps-apis/credentials
# Activa "Maps JavaScript API" para tu proyecto.

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change_me

# Optional: control the seeded sysadmin account (created on first run).
# If unset, a default admin@local is created with a random printed password.
SYSADMIN_EMAIL=admin@local
SYSADMIN_PASSWORD=change_me

# Server binding. Use APP_HOST=0.0.0.0 so the app is reachable from the LAN.
APP_HOST=0.0.0.0
APP_PORT=8002
APP_PUBLIC_URL=https://gestordeproyecctiones

# Persistent projection attachments. On clbi04 this resolves to:
# /home/mbustos/GestorDeProyecciones/DocumentosProyeccion
PROJECTION_DOCUMENTS_DIR=/home/mbustos/GestorDeProyecciones/DocumentosProyeccion
PROJECTION_ATTACHMENT_MAX_BYTES=15728640
PROJECTION_ATTACHMENT_MAX_FILES=12

# Optional: Postgres source used by POST /admin/import-postgres.
# On the 172.23.1.128 server, PostgreSQL is expected to be local to the app host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=TinderLocales
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_CONNECT_TIMEOUT=10
PG_SCHEMA=dw_simi
CAND_TABLE=SolicitudesProyecciones
BUS_TABLES=PI_Ahumada,PI_CruzVerde,PI_Salcobrand,PI_Maicao,PI_EstacionesMetro,LocalesSimi

# Optional automatic Postgres sync. Default: enabled every 30 minutes.
POSTGRES_AUTO_SYNC=true
POSTGRES_SYNC_INTERVAL_SECONDS=1800
POSTGRES_SYNC_PROJECT_NAME=Postgres Sync

# Import IDs >= 450 plus the explicitly included historical projections.
CANDIDATE_MIN_ID=450
CANDIDATE_INCLUDE_IDS=387, 427, 40, 63, 77, 155, 163, 254, 321, 324, 361, 366, 410, 98, 124, 157, 323, 412, 413, 407
SITE_SWIPER_USE_POSTGRES=true
