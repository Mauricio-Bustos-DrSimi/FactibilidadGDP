# Copia este archivo como .env y pon tu clave aqui.
# Obten una clave en: https://console.cloud.google.com/google/maps-apis/credentials
# Activa "Maps JavaScript API" para tu proyecto.

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change_me
SESSION_COOKIE_NAME=factibilidad_session

# Optional: control the seeded sysadmin account (created on first run).
# If unset, a default admin@local is created with a random printed password.
SYSADMIN_EMAIL=admin@local
SYSADMIN_PASSWORD=change_me

# Server binding. Use APP_HOST=0.0.0.0 so the app is reachable from the LAN.
APP_HOST=0.0.0.0
APP_PORT=8003
APP_PUBLIC_URL=http://172.23.1.128:8003

# Persistent projection attachments. On clbi04 this resolves to:
# This directory must not be shared with the service on port 8002.
PROJECTION_DOCUMENTS_DIR=/home/mbustos/FactibilidadGDP/DocumentosProyeccion
LEGACY_DOCUMENTS_DIR=/home/mbustos/GestorDeProyecciones/DocumentosProyeccion
DOCUMENT_INVENTORY_SECONDS=300
PROJECTION_ATTACHMENT_MAX_BYTES=15728640
PROJECTION_ATTACHMENT_MAX_FILES=12

# Independent PostgreSQL connections. Put real credentials only in .env.
# URL-encode reserved characters in usernames/passwords.
DATABASE_URL=postgresql+psycopg2://factibilidad_app:change_me@localhost:5433/FactibilidadGDP
LEGACY_DATABASE_URL=postgresql+psycopg2://gestor_readonly:change_me@localhost:5433/TinderLocales
SOURCE_DATABASE_URL=postgresql+psycopg2://source_readonly:change_me@localhost:5433/TinderLocales
CDC_DATABASE_URL=postgresql+psycopg2://gestor_replication:change_me@localhost:5433/TinderLocales

# Safe coexistence defaults. Keep polling until CDC source objects are explicitly authorized.
SHADOW_MODE=true
LEGACY_SYNC_ENABLED=true
REPLICATION_MODE=polling
REPLICATION_POLL_SECONDS=5
REPLICATION_LAG_ALERT_SECONDS=60
CDC_SLOT_NAME=factibilidad_gdp_slot
EMAIL_DELIVERY_ENABLED=false
ALEMBIC_MANAGED_SCHEMA=true
FACTIBILIDAD_SCHEMA=factibilidad
TARGET_SEARCH_PATH=gestor,factibilidad,integracion,public

# The old dw_simi importer is not the 8002 transactional replica.
POSTGRES_AUTO_SYNC=false
