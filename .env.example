# Copia este archivo como .env y pon tu clave aquí.
# Obtén una clave en: https://console.cloud.google.com/google/maps-apis/credentials
# Activa "Maps JavaScript API" para tu proyecto.

GOOGLE_MAPS_API_KEY=your-api-key-here

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# Optional: control the seeded sysadmin account (created on first run).
# If unset, a default admin@local is created with a random printed password.
SYSADMIN_EMAIL=admin@local
SYSADMIN_PASSWORD=change-me

# Optional: Postgres source used by POST /admin/import-postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=TinderLocales
POSTGRES_USER=admin_tinder_user
POSTGRES_PASSWORD=admin_tinder_pass_1234
PG_SCHEMA=dw_simi
CAND_TABLE=SolicitudesProyecciones
BUS_TABLES=PI_Ahumada,PI_CruzVerde,PI_Salcobrand,PI_Maicao,PI_EstacionesMetro
