# Copia este archivo como .env y pon tu clave aquí.
# Obtén una clave en: https://console.cloud.google.com/google/maps-apis/credentials
# Activa "Maps JavaScript API" para tu proyecto.

GOOGLE_MAPS_API_KEY=cambiar_clave

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=cambiar_clave

# Optional: control the seeded sysadmin account (created on first run).
# If unset, a default admin@local is created with a random printed password.
SYSADMIN_EMAIL=usuario@ejemplo.cl
SYSADMIN_PASSWORD=cambiar_password

# Optional: Postgres source used by POST /admin/import-postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=0
POSTGRES_DB=nombre_base_ejemplo
POSTGRES_USER=false
POSTGRES_PASSWORD=cambiar_password
PG_SCHEMA=
CAND_TABLE=
BUS_TABLES=

# Optional automatic Postgres sync. Default: enabled every 30 minutes.
POSTGRES_AUTO_SYNC=
POSTGRES_SYNC_INTERVAL_SECONDS=0
POSTGRES_SYNC_PROJECT_NAME=

CANDIDATE_MIN_ID=0
SITE_SWIPER_USE_POSTGRES=false
