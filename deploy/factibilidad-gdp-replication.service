[Unit]
Description=FactibilidadGDP one-way legacy replication worker
After=network-online.target factibilidad-gdp.service
Wants=network-online.target

[Service]
Type=simple
User=mbustos
Group=mbustos
WorkingDirectory=/home/mbustos/FactibilidadGDP
EnvironmentFile=/home/mbustos/FactibilidadGDP/.env
ExecStart=/home/mbustos/FactibilidadGDP/.venv/bin/python -m app.replication.worker
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/mbustos/FactibilidadGDP/data

[Install]
WantedBy=multi-user.target
